// Some of the items can be modified to match the user's preference
// appB variant: separate app so it does not overwrite an existing Trio install.
APP_DISPLAY_NAME = TrioB
APP_ICON = trioBlack
APP_URL_SCHEME = TrioB

// DEVELOPER_TEAM will be set to your Apple Developer ID - typically using ConfigOverride.xcconfig
DEVELOPER_TEAM = ##TEAM_ID##

// Typically this is not modified unless you want to create a separate (unique) app using your ID
// It must include $(DEVELOPMENT_TEAM)
// For example: myOwnApp.$(DEVELOPMENT_TEAM).trio
// appB variant: builds a separate app alongside the original Trio.
BUNDLE_IDENTIFIER = org.nightscout.$(DEVELOPMENT_TEAM).trioappB

// Danger zone - do not modify these unless you know what you are doing

// App group kept in the same format, isolated to the appB bundle so the appB
// build does not share its container with an existing Trio install.
TRIO_APP_GROUP_ID = group.org.nightscout.$(DEVELOPMENT_TEAM).trioappB.trio-app-group

// The developers set the version numbers, please leave them alone
APP_VERSION = 0.8.3
APP_DEV_VERSION = 0.8.3.4
APP_BUILD_NUMBER = 1
COPYRIGHT_NOTICE =

// Optional overrides - these can be used to insert your TEAMID into the DEVELOPER_TEAM field
#include? "../../ConfigOverride.xcconfig"
#include? "../ConfigOverride.xcconfig"
#include? "ConfigOverride.xcconfig"
